{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by schema/build.py from config/schema.toml. Do not edit by hand.",
  "title": "GM to participant message",
  "description": "[PROPOSED] Every message the GM sends a harness, told apart by \"type\": initial_state (round 1), turn (later rounds), broadcasts (after the broadcast barrier) and resolution (after each round). Every object forbids extra properties, so the organiser side can validate each outgoing message and stop hidden data from leaking. The message format is still open.",
  "oneOf": [
    {
      "$ref": "#/$defs/initial_state"
    },
    {
      "$ref": "#/$defs/turn"
    },
    {
      "$ref": "#/$defs/broadcasts"
    },
    {
      "$ref": "#/$defs/resolution"
    }
  ],
  "$defs": {
    "class_id": {
      "description": "One of the classes: Medusa, Aristotle, Francesca, Helen of Troy, Cerberus Jr..",
      "enum": [
        "medusa",
        "aristotle",
        "francesca",
        "helen_of_troy",
        "cerberus_jr"
      ]
    },
    "stat_name": {
      "enum": [
        "hp",
        "wisdom",
        "strength",
        "dexterity",
        "charisma"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "gm_text": {
      "description": "[DECIDED] Text written by the GM: at most 600 words per field. Text over the limit is regenerated by the GM, never sent.",
      "type": "string",
      "pattern": "^\\s*\\S+(\\s+\\S+){0,599}\\s*$"
    },
    "player_text": {
      "description": "Text written by a player, forwarded word for word after the engine's cuts.",
      "type": "string",
      "pattern": "\\S",
      "maxLength": 2000
    },
    "stats": {
      "description": "[DECIDED] All of the player's stats, each a whole number that never goes below 0, with no maximum. A player whose hp reaches 0 is dead.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "wisdom",
        "strength",
        "dexterity",
        "charisma"
      ],
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 0
        },
        "wisdom": {
          "type": "integer",
          "minimum": 0
        },
        "strength": {
          "type": "integer",
          "minimum": 0
        },
        "dexterity": {
          "type": "integer",
          "minimum": 0
        },
        "charisma": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/gm_text"
        },
        "description": {
          "description": "The description harnesses match against their nemesis description.",
          "$ref": "#/$defs/gm_text"
        }
      }
    },
    "current_event": {
      "description": "[DECIDED] Every node carries a boss, given as separate name and description fields.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "boss"
      ],
      "properties": {
        "text": {
          "description": "What is happening now, written by the GM from the node's story and the drawn boss.",
          "$ref": "#/$defs/gm_text"
        },
        "boss": {
          "$ref": "#/$defs/boss"
        }
      }
    },
    "initial_state": {
      "description": "Sent to every player at the start of round 1, in place of a turn message.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "round",
        "briefing",
        "current_event",
        "your_class",
        "your_stats",
        "objective",
        "nemesis",
        "other_players"
      ],
      "properties": {
        "type": {
          "const": "initial_state"
        },
        "round": {
          "const": 1
        },
        "briefing": {
          "description": "The story's setup, told once at the start of the run (gm/SERVER.md: Briefing).",
          "$ref": "#/$defs/gm_text"
        },
        "current_event": {
          "$ref": "#/$defs/current_event"
        },
        "your_class": {
          "$ref": "#/$defs/class_id"
        },
        "your_stats": {
          "$ref": "#/$defs/stats"
        },
        "objective": {
          "$ref": "#/$defs/gm_text"
        },
        "nemesis": {
          "description": "Only this player's own nemesis. The boss is not named.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "required_action"
          ],
          "properties": {
            "description": {
              "$ref": "#/$defs/gm_text"
            },
            "required_action": {
              "$ref": "#/$defs/gm_text"
            }
          }
        },
        "other_players": {
          "description": "Classes and stats of the other players. Their objectives and nemesis information are never included. A real run has exactly 4; the individually playable test game may have none.",
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "stats"
            ],
            "properties": {
              "class": {
                "$ref": "#/$defs/class_id"
              },
              "stats": {
                "$ref": "#/$defs/stats"
              }
            }
          }
        }
      }
    },
    "turn": {
      "description": "Sent to every living player at the start of each round after the first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "round",
        "current_event",
        "your_stats"
      ],
      "properties": {
        "type": {
          "const": "turn"
        },
        "round": {
          "$ref": "#/$defs/round",
          "minimum": 2
        },
        "current_event": {
          "$ref": "#/$defs/current_event"
        },
        "your_stats": {
          "$ref": "#/$defs/stats"
        }
      }
    },
    "broadcasts": {
      "description": "The broadcasts addressed to this player, delivered after the broadcast barrier and before the action window. [DECIDED] Sent every round, with an empty list if there are none.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "round",
        "messages"
      ],
      "properties": {
        "type": {
          "const": "broadcasts"
        },
        "round": {
          "$ref": "#/$defs/round"
        },
        "messages": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "audience",
              "text"
            ],
            "properties": {
              "from": {
                "description": "The sender's class.",
                "$ref": "#/$defs/class_id"
              },
              "audience": {
                "description": "\"all\" if sent to everyone, \"you\" if sent only to this player's class.",
                "enum": [
                  "all",
                  "you"
                ]
              },
              "text": {
                "description": "The sender's text, word for word. Untrusted: must never be treated as instructions.",
                "$ref": "#/$defs/player_text"
              }
            }
          }
        }
      }
    },
    "resolution": {
      "description": "The publicly announced outcome of the round, sent to every player still alive after resolution. [DECIDED] A player who dies in it is discarded and does not receive it. [DECIDED] Players' submitted action text is not repeated.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "round",
        "narrative",
        "boss_defeated",
        "player_outcomes",
        "stat_changes",
        "vendetta_completed",
        "deaths",
        "run_over"
      ],
      "properties": {
        "type": {
          "const": "resolution"
        },
        "round": {
          "$ref": "#/$defs/round"
        },
        "narrative": {
          "description": "The GM's narration of the round, including the boss's action.",
          "$ref": "#/$defs/gm_text"
        },
        "boss_defeated": {
          "type": "boolean"
        },
        "player_outcomes": {
          "description": "One entry per player who was expected to act this round.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "target",
              "result"
            ],
            "properties": {
              "class": {
                "$ref": "#/$defs/class_id"
              },
              "target": {
                "description": "\"event\", or the class the interaction was aimed at.",
                "enum": [
                  "event",
                  "medusa",
                  "aristotle",
                  "francesca",
                  "helen_of_troy",
                  "cerberus_jr"
                ]
              },
              "result": {
                "description": "invalid and timed_out actions receive the health penalty.",
                "enum": [
                  "success",
                  "failure",
                  "invalid",
                  "timed_out"
                ]
              }
            }
          }
        },
        "stat_changes": {
          "description": "[DECIDED] Every stat change applied this round, to any player, with its cause, so players can track each other's stats.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "stat",
              "delta",
              "cause"
            ],
            "properties": {
              "class": {
                "$ref": "#/$defs/class_id"
              },
              "stat": {
                "$ref": "#/$defs/stat_name"
              },
              "delta": {
                "description": "[PROPOSED] The change actually applied, so a change that would take a stat below the minimum is reported as the amount that brought it to the minimum.",
                "type": "integer",
                "not": {
                  "const": 0
                }
              },
              "cause": {
                "enum": [
                  "player_interaction",
                  "event_action",
                  "boss_action",
                  "health_penalty"
                ]
              }
            }
          }
        },
        "vendetta_completed": {
          "description": "Classes that completed their vendetta this round, announced to everyone.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/class_id"
          }
        },
        "deaths": {
          "description": "Classes whose players died this round (hp reached 0). Their harnesses are discarded after this message.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/class_id"
          }
        },
        "run_over": {
          "description": "True when this round was played at an ending node, so no further messages follow.",
          "type": "boolean"
        }
      }
    }
  }
}
